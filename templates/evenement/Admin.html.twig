{% extends 'back.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}


            <div class="events-table-section">
                <div class="container">
                    <div class="section-title">
                        <h1>Gestion des Événements</h1>
                        <p>Interface d'administration des événements</p>
                    </div>

                    <div class="events-table-container">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>NOM</th>
                                        <th>DESCRIPTION</th>
                                        <th>DATE</th>
                                        <th>LIEU</th>
                                        <th>ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for evenement in evenements %}
                                    <tr>
                                        <td class="text-center">{{ evenement.id }}</td>
                                        <td><strong>{{ evenement.nom }}</strong></td>
                                        <td>{{ evenement.description }}</td>
                                        <td class="text-center">{{ evenement.date ? evenement.date|date('d/m/Y') : '' }}</td>
                                        <td>{{ evenement.lieu }}</td>
                                        <td class="text-center">
                                            <a href="{{ path('associer_categorie', {'id': evenement.id}) }}" class="btn btn-success btn-sm">
                                                + Catégorie
                                            </a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6" class="no-events">Aucun événement trouvé</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}
    