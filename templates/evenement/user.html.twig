{# templates/evenement/index.html.twig #}
{% extends 'basefront.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    <style>
      /* make the search‐icon button smaller */
      .search-icon {
        font-size: 16px !important;   /* smaller icon */
        padding: 4px !important;      /* very little padding */
        width: auto !important;       /* don’t force a large width */
      }
      /* optionally tighten up the input so the icon sits nicely */
      .search-input {
        padding-right: 36px;
      }
    </style>
{% endblock %}

{% block title %}Événements à venir{% endblock %}

{% block main %}
<section class="events-section py-5 bg-light">
  <div class="container">
    <div class="row mb-4 align-items-center">
      <div class="col-md-6">
        <h2 class="font-weight-bold">Événements à venir</h2>
        {% if searchTerm %}
          <p class="text-muted">Résultats pour : « {{ searchTerm }} »</p>
        {% endif %}
      </div>
      <div class="col-md-6">
        <form method="get" action="{{ path('app_evenement_indexa') }}" class="form-inline justify-content-md-end">
          <div class="input-group w-100 w-md-auto">
            <input
              type="text"
              name="search"
              class="form-control"
              placeholder="Rechercher un événement…"
              value="{{ searchTerm }}"
            >
            <div class="input-group-append">
              <button class="btn btn-primary" type="submit">
                <i class="fas fa-search"></i>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    {% if evenements|length > 0 %}
      <div class="row">
        {% for evenement in evenements %}
          {% if evenement.categories|length > 0 %}
            <div class="col-sm-6 col-lg-4 mb-4">
              <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title">{{ evenement.nom }}</h5>
                  <p class="text-muted small mb-2">
                    <i class="far fa-calendar-alt"></i>
                    {{ evenement.date ? evenement.date|date('d/m/Y') : '—' }}
                    &nbsp;|&nbsp;
                    <i class="fas fa-map-marker-alt"></i>
                    {{ evenement.lieu }}
                  </p>
                  <p class="card-text flex-grow-1">
                    {{ evenement.description|length > 100
                       ? evenement.description|slice(0, 100) ~ '…'
                       : evenement.description }}
                  </p>
                  <div class="mb-3">
                    {% for categorie in evenement.categories %}
                      <span class="badge badge-info badge-pill mr-1">
                        {{ categorie.nom }}
                      </span>
                    {% endfor %}
                  </div>
                  <a
                    href="{{ path('app_ticket_new', {id: evenement.id}) }}"
                    class="btn btn-outline-primary btn-block mt-auto"
                  >
                    Acheter un ticket
                  </a>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="alert alert-warning text-center">
        {% if searchTerm %}
          Aucun événement trouvé pour « {{ searchTerm }} »
        {% else %}
          Aucun événement trouvé.
        {% endif %}
      </div>
    {% endif %}

    <div class="famous-event-banner mt-5 p-4 bg-dark text-white rounded d-flex flex-column flex-md-row justify-content-between align-items-center">
  <div class="mb-3 mb-md-0">
    {% if mostFamousEventName %}
      <h5 class="mb-1 text-white">Événement le plus célèbre :</h5>
      <h3 class="font-weight-bold mb-0 text-white">{{ mostFamousEventName }}</h3>
    {% else %}
      <p class="mb-0 text-white">Aucun événement célèbre trouvé.</p>
    {% endif %}
  </div>
  <a href="{{ path('app_user_fire') }}" class="btn btn-outline-light btn-lg">
    🔥 Voir les catégories 🔥
  </a>
</div>

  </div>
</section>
{% endblock %}
