<!doctype html>
<html class="no-js" lang="zxx">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>Health & Fitness | Associer Catégorie</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- CSS -->
    <link rel="stylesheet" href="assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="assets/css/style.css">

    <style>
        /* Supprimer marges et paddings par défaut */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Barre noire haut/bas */
        .black-bar {
            height: 70px;
            background-color: black;
            width: 100%;
            position: fixed;
            left: 0;
            z-index: 1000;
        }

        .black-bar.top {
            top: 0;
        }

        .black-bar.bottom {
            bottom: 0;
        }

        /* Contenu principal */
        main {
            margin-top: 80px; /* Espacement pour la barre noire en haut */
            padding-bottom: 80px; /* Espacement pour la barre noire en bas */
            padding-left: 0;
            padding-right: 0;
        }

        .events-table-section {
            padding: 80px 0; /* Augmenté de 60px */
            background-color: #f9f9f9;
            min-height: calc(100vh - 140px);
        }

        .events-table-container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            padding: 40px; /* Augmenté de 30px */
            margin: 0 auto;
            max-width: 1200px;
        }

        .table thead th {
            border-bottom: 2px solid #dee2e6;
            font-weight: 700;
            color: #333;
            font-size: 18px;
        }

        .table td, .table th {
            vertical-align: middle;
            padding: 15px;
            font-size: 16px;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(0,0,0,0.02);
        }

        .section-title h2 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .form-section {
            margin: 40px 0; /* Augmenté de 30px */
            padding: 30px; /* Augmenté de 25px */
            background: #f8f9fa;
            border-radius: 8px;
            border-left: 4px solid #007bff;
        }

        .form-section h2 {
            color: #333;
            margin-bottom: 25px; /* Augmenté de 20px */
        }

        /* Button container for better spacing */
        .button-container {
            display: flex;
            gap: 30px; /* Espace entre les boutons */
            margin-top: 40px; /* Augmenté de 20px */
        }

        .btn-custom-blue {
            padding: 16px 40px; /* Augmenté de 14px 35px */
            font-size: 22px; /* Augmenté de 20px */
            font-weight: bold;
            background-color: #007bff;
            border: none;
            color: white;
            border-radius: 6px;
            transition: all 0.3s ease;
            display: inline-block;
            text-align: center;
            min-width: 220px; /* Largeur uniforme */
        }

        .btn-custom-blue:hover {
            background-color: #0069d9;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .btn-custom-blue:active {
            transform: translateY(0);
        }

        /* Bouton rouge */
        .btn-custom-red {
            padding: 16px 40px; /* Augmenté de 14px 35px */
            font-size: 22px; /* Augmenté de 20px */
            font-weight: bold;
            background-color: #dc3545;
            border: none;
            color: white;
            border-radius: 6px;
            transition: all 0.3s ease;
            display: inline-block;
            text-align: center;
            min-width: 220px; /* Largeur uniforme */
        }

        .btn-custom-red:hover {
            background-color: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .btn-custom-red:active {
            transform: translateY(0);
        }

        /* Form elements spacing */
        .form-group {
            margin-bottom: 25px; /* Espacement entre les champs du formulaire */
        }

        /* Agrandir les champs du formulaire */
        .form-control {
            padding: 12px 15px;
            font-size: 16px;
            height: auto;
        }

    </style>
</head>
<body>

<!-- Barre noire haut -->
<div class="black-bar top"></div>

<main class="events-table-section">
    <div class="container">
        <div class="events-table-container">
            {% block body %}
                <h1>Edit événement</h1>

                <!-- Inclure le formulaire d'édition -->
                {{ include('evenement/_form.html.twig', {'button_label': 'Update'}) }}

                <!-- Lien de retour vers la liste -->
                <a href="{{ path('app_evenement_indexz') }}" class="btn-custom-blue">Back to list</a>

                
            {% endblock %}
        </div>
    </div>
</main>

<!-- Barre noire bas -->
<div class="black-bar bottom"></div>

</body>
</html>
