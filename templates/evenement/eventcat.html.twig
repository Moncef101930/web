{# templates/utilisateur/index.html.twig #}
{% extends 'back.html.twig' %}

{% block title %}Categorie{% endblock %}

{% block body %}

<main class="events-table-section">
    <div class="container">
        <div class="events-table-container">

                <h1 class="text-center mb-4">Association de catégorie à l'événement</h1>

                <table class="table mt-4">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Description</th>
                            <th>Lieu</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>{{ evenement.nom }}</td>
                            <td>{{ evenement.description }}</td>
                            <td>{{ evenement.lieu }}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="form-section">
                    <h2>Ajouter une catégorie</h2>
                    {{ include('evenement/_form.html.twig', {
                        'button_label': 'Associer+',
                        'button_class': 'btn-custom-blue'
                    }) }}
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('app_evenement_indexy') }}" class="btn btn-secondary">← Retour à la liste</a>
                </div>
        </div>
    </div>
</main>
{% endblock %}

