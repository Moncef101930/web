<!doctype html>
<html class="no-js" lang="zxx">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>Health & Fitness | Événements</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- CSS -->
    <link rel="stylesheet" href="assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="assets/css/style.css">

    <style>
    .btn-custom-green {
    background-color: #28a745; /* Vert */
    color: white; /* Texte en blanc */
    border: none; /* Pas de bordure */
    padding: 10px 20px; /* Espacement à l'intérieur du bouton */
    font-size: 16px; /* Taille du texte */
    border-radius: 5px; /* Coins arrondis */
    text-align: center; /* Centrer le texte */
    display: inline-block; /* Affichage en ligne */
    text-decoration: none; /* Enlever le soulignement du lien */
}

.btn-custom-green:hover {
    background-color: #218838; /* Vert plus foncé au survol */
}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .black-bar {
            height: 70px;
            background-color: black;
            width: 100%;
            position: fixed;
            left: 0;
            z-index: 1000;
        }

        .black-bar.top {
            top: 0;
        }

        .black-bar.bottom {
            bottom: 0;
        }

        main {
            margin-top: 80px;
            padding-bottom: 80px;
            padding-left: 0;
            padding-right: 0;
        }

        .events-table-section {
            padding: 60px 0;
            background-color: #f9f9f9;
            min-height: calc(100vh - 140px);
        }

        .events-table-container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            padding: 30px;
            margin: 0 auto;
            max-width: 1200px;
        }

        .table {
            width: 100%;
            margin-bottom: 1rem;
            color: #212529;
        }

        .table thead th {
            border-bottom: 2px solid #dee2e6;
            font-weight: 700;
            color: #333;
            font-size: 18px;
            vertical-align: bottom;
        }

        .table td, .table th {
            padding: 15px;
            vertical-align: middle;
            border-top: 1px solid #dee2e6;
            font-size: 16px;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(0,0,0,0.02);
        }

        h1 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 30px;
            color: #333;
        }

        .btn-custom-blue {
            padding: 12px 25px;
            font-size: 16px;
            font-weight: bold;
            background-color: #007bff;
            border: none;
            color: white;
            border-radius: 6px;
            transition: all 0.3s ease;
            display: inline-block;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            margin-right: 10px;
        }

        .btn-custom-blue:hover {
            background-color: #0069d9;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .btn-custom-red {
            padding: 12px 25px;
            font-size: 16px;
            font-weight: bold;
            background-color: #dc3545;
            border: none;
            color: white;
            border-radius: 6px;
            transition: all 0.3s ease;
            display: inline-block;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
        }

        .btn-custom-red:hover {
            background-color: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .action-buttons {
            display: flex;
            gap: 10px;
        }

        .create-pdf-buttons {
            margin-top: 30px;
            display: flex;
            gap: 10px;
        }

        .no-records {
            text-align: center;
            padding: 20px;
            color: #6c757d;
            font-style: italic;
        }
    </style>
</head>
<body>

<!-- Barre noire haut -->
<div class="black-bar top"></div>

<main class="events-table-section">
    <div class="container">
        <div class="events-table-container">
            <h1>Événements (organisateur)</h1>

            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Lieu</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for evenement in evenements %}
                    <tr>
                        <td>{{ evenement.id }}</td>
                        <td>{{ evenement.nom }}</td>
                        <td>{{ evenement.description }}</td>
                        <td>{{ evenement.date ? evenement.date|date('Y-m-d') : '' }}</td>
                        <td>{{ evenement.lieu }}</td>
                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn-custom-blue">Modifier</a>
                                <form method="POST" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                                    <button type="submit" class="btn-custom-red">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="no-records">Aucun événement trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <!-- Boutons Créer + PDF -->
            <div class="create-pdf-buttons">
                <a href="{{ path('app_evenement_creer') }}" class="btn-custom-red">Créer un événement</a>
                <a href="{{ path('app_evenement_pdf') }}" class="btn-custom-blue">Télécharger PDF</a>
                <a href="{{ path('app_evenement_statistiquess') }}" class="btn-custom-green">Statistiques</a>
            </div>

        </div>
    </div>
</main>

<!-- Barre noire bas -->
<div class="black-bar bottom"></div>

<!-- JavaScript -->
<script>
    function confirmDelete(event) {
        if (!confirm('Êtes-vous sûr de vouloir supprimer cet événement ?')) {
            event.preventDefault();
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const deleteForms = document.querySelectorAll('form[action*="delete"]');
        deleteForms.forEach(form => {
            form.addEventListener('submit', confirmDelete);
        });
    });
</script>

</body>
</html>
