{% extends 'back.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
<div class="content mt-3">
  <div class="animated fadeIn">
    <div class="card">

      {# ─── Live Search + Sort + New Button ───────────────────────────── #}
      <div class="card-header">
        <div class="form-row align-items-center">
          <div class="col-auto">
            <input type="text"
                   id="search-input"
                   class="form-control"
                   placeholder="Rechercher…">
          </div>
          <div class="col-auto">
            <select id="sort-select" class="form-control">
              <option value="">Trier par…</option>
              <option value="id_asc">ID ↑</option>
              <option value="id_desc">ID ↓</option>
              <option value="nom_asc">Nom ↑</option>
              <option value="nom_desc">Nom ↓</option>
              <option value="prenom_asc">Prénom ↑</option>
              <option value="prenom_desc">Prénom ↓</option>
              <option value="email_asc">Email ↑</option>
              <option value="email_desc">Email ↓</option>
              <option value="role_asc">Rôle ↑</option>
              <option value="role_desc">Rôle ↓</option>
              <option value="dateNaissance_asc">Naissance ↑</option>
              <option value="dateNaissance_desc">Naissance ↓</option>
            </select>
          </div>
          <div class="col-auto ml-auto">
            <a class="btn btn-success btn-sm" href="{{ path('app_utilisateur_new') }}">
              <i class="fa fa-plus mr-1"></i> Nouvel Utilisateur
            </a>
          </div>
        </div>
      </div>

      {# ─── Table ────────────────────────────────────────────────────── #}
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0">
            <thead class="thead-light">
              <tr>
                <th>ID</th><th>Nom</th><th>Prénom</th><th>Email</th>
                <th>Rôle</th><th>Naissance</th><th>Bio</th><th>Photo</th><th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody id="user-table-body">
              {{ include('utilisateur/_rows.html.twig') }}
            </tbody>
          </table>
        </div>
      </div>

      {# ─── Pagination ──────────────────────────────────────────────── #}
      <div class="card-footer">
        <nav aria-label="Pagination">
          <div id="user-pagination">
            {{ include('utilisateur/_pagination.html.twig') }}
          </div>
        </nav>
      </div>

    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    (function($){
      let debounce, currentSearch = '', currentSort = '', currentDir = '';

      function loadPage(page=1) {
        $.ajax({
          url: "{{ path('app_utilisateur_index') }}",
          data: {
            search:    currentSearch,
            sort:      currentSort,
            direction: currentDir,
            page:      page
          },
          success(response) {
            $('#user-table-body').html(response.table);
            $('#user-pagination').html(response.pagination);
          }
        });
      }

      $(function(){
        $('#search-input').on('input', function(){
          clearTimeout(debounce);
          currentSearch = $(this).val();
          debounce = setTimeout(()=> loadPage(1), 300);
        });

        $('#sort-select').on('change', function(){
          const [f, d] = $(this).val().split('_');
          currentSort = f||'';
          currentDir  = d||'';
          loadPage(1);
        });

        $(document).on('click', '#user-pagination a', function(e){
          e.preventDefault();
          const page = $(this).attr('href').match(/page=(\d+)/)[1];
          loadPage(page);
        });
      });
    })(jQuery);
  </script>
{% endblock %}
