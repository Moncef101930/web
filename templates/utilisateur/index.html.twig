{# templates/utilisateur/index.html.twig #}
{% extends 'back.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
<div class="content mt-3">
  <div class="animated fadeIn">
    <div class="card">
      <div class="card-header">
        <div class="row w-100 align-items-center">
          <div class="col-md-4">
            <h5 class="mb-0">Liste des Utilisateurs</h5>
          </div>
          <div class="col-md-4">
            <form method="get" action="{{ path(app.request.attributes.get('_route')) }}" class="input-group">
              <input type="text" name="search" value="{{ app.request.get('search') }}" class="form-control form-control-sm" placeholder="Rechercher Utilisateur">
              <div class="input-group-append">
                <button type="submit" class="btn btn-sm btn-primary">
                  <i class="fa fa-search"></i>
                </button>
              </div>
            </form>
          </div>
          <div class="col-md-4 text-right">
            <a class="btn btn-success btn-sm" href="{{ path('app_utilisateur_new') }}">
              <i class="fa fa-plus mr-1"></i> Nouvel Utilisateur
            </a>
          </div>
        </div>
      </div>

      <div class="card-body p-0">
      
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0">
            <thead class="thead-light">
              <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Naissance</th>
                <th>Bio</th>
                <th>Photo</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody id="user-table-body">
              {% for u in pagination %}
                <tr>
                  <td>{{ u.id }}</td>
                  <td>{{ u.nom }}</td>
                  <td>{{ u.prenom }}</td>
                  <td>{{ u.email }}</td>
                  <td>{{ u.role }}</td>
                  <td>{{ u.dateNaissance ? u.dateNaissance|date('d/m/Y') : '-' }}</td>
                  <td>{{ u.bio|length > 30 ? u.bio|slice(0,30) ~ '…' : u.bio }}</td>
                  <td>
                    <img 
                      src="{{ asset('images/' ~ u.image) }}" 
                      alt="{{ u.nom }}" 
                      style="width:40px; height:40px; object-fit:cover; border-radius:4px;"
                    >
                  </td>
                  <td class="text-center">
                    <a 
                        class="btn btn-sm btn-primary"
                        title="Voir"
                        href="{{ path('app_utilisateur_show', {'id': u.id}) }}"
                    >
                        <i class="fas fa-eye fa-fw"></i>Voir
                    </a>
                    <a 
                        class="btn btn-sm btn-secondary"
                        title="Modifier"
                        href="{{ path('app_utilisateur_edit', {'id': u.id}) }}"
                    >
                        <i class="fas fa-edit fa-fw"></i>Modifier
                    </a>
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="9" class="text-center py-4">Aucun utilisateur trouvé.</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

      <div class="card-footer">
        <nav aria-label="Page navigation">
          {{ knp_pagination_render(pagination) }}
        </nav>
      </div>

    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const searchInput = document.querySelector('input[name="search"]');
  const tableBody = document.getElementById("user-table-body");

  let timer;

  searchInput.addEventListener("keyup", function () {
    clearTimeout(timer);
    timer = setTimeout(() => {
      const query = searchInput.value;

      fetch(`?search=${encodeURIComponent(query)}`, {
        headers: { "X-Requested-With": "XMLHttpRequest" }
      })
      .then(response => response.text())
      .then(html => {
        // Create a temporary DOM parser
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        // Get the new tbody from the response
        const newTbody = doc.querySelector('#user-table-body');
        if (newTbody) {
          tableBody.innerHTML = newTbody.innerHTML;
        }
      });
    }, 300); // debounce
  });
});
</script>


{% endblock %}
