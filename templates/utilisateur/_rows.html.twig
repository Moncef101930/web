{# just the <tr>… loops #}
{% for u in pagination %}
  <tr>
    <td>{{ u.id }}</td>
    <td>{{ u.nom }}</td>
    <td>{{ u.prenom }}</td>
    <td>{{ u.email }}</td>
    <td>{{ u.role }}</td>
    <td>{{ u.dateNaissance ? u.dateNaissance|date('d/m/Y') : '-' }}</td>
    <td>{{ u.bio|length > 30 ? u.bio|slice(0,30) ~ '…' : u.bio }}</td>
    <td>
      <img src="{{ asset('images/' ~ u.image) }}"
           style="width:40px;height:40px;object-fit:cover;border-radius:4px;"
           alt="{{ u.prenom }}">
    </td>
    <td class="text-center">
      <a class="btn btn-sm btn-primary" href="{{ path('app_utilisateur_show',{id:u.id}) }}">
        <i class="fas fa-eye"></i>
      </a>
      <a class="btn btn-sm btn-secondary" href="{{ path('app_utilisateur_edit',{id:u.id}) }}">
        <i class="fas fa-edit"></i>
      </a>
    </td>
  </tr>
{% else %}
  <tr>
    <td colspan="9" class="text-center py-4">Aucun utilisateur trouvé.</td>
  </tr>
{% endfor %}
