{% extends 'back.html.twig' %}

{% block title %}Utilisateur Details{% endblock %}

{% block body %}
    <div class="breadcrumbs">
        <div class="col-sm-4">
            <div class="page-header float-left">
                <div class="page-title">
                    <h1>Utilisateur Details</h1>
                </div>
            </div>
        </div>
        <div class="col-sm-8">
            <div class="page-header float-right">
                <div class="page-title">
                    <ol class="breadcrumb text-right">
                        <li><a href="{{ path('home') }}">Dashboard</a></li>
                        <li><a href="{{ path('app_utilisateur_index') }}">Utilisateur</a></li>
                        <li class="active">Show</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="card">
                <div class="card-header">
                    <strong class="card-title">Utilisateur Details</strong>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <tbody>
                            <tr>
                                <th scope="row">Id</th>
                                <td>{{ utilisateur.id }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Nom</th>
                                <td>{{ utilisateur.nom }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Prenom</th>
                                <td>{{ utilisateur.prenom }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Email</th>
                                <td>{{ utilisateur.email }}</td>
                            </tr>
                            
                            <tr>
                                <th scope="row">Role</th>
                                <td>{{ utilisateur.role }}</td>
                            </tr>
                            <tr>
                                <th scope="row">DateNaissance</th>
                                <td>{{ utilisateur.dateNaissance ? utilisateur.dateNaissance|date('Y-m-d') : '' }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Bio</th>
                                <td>{{ utilisateur.bio }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Image</th>
                                <td>{{ utilisateur.image }}</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mt-3">
                        <a href="{{ path('app_utilisateur_index') }}" class="btn btn-secondary">Back to list</a>
                        <a href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}" class="btn btn-primary">Edit</a>
                        {{ include('utilisateur/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
