    <style>
        .main-menu #navigation li a {
            font-size: 18px;
            margin-right: 20px;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .main-menu #navigation li a:hover {
            color: #fdc632;
        }

        html {
            scroll-behavior: smooth;
        }

        .btn, .header-btn, .hero-btn, .wantToWork-btn {
            transition: all 0.3s ease;
        }

        .btn:hover, .header-btn:hover, .hero-btn:hover, .wantToWork-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        #back-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 999;
            width: 40px;
            height: 40px;
            line-height: 40px;
            text-align: center;
            background: #fdc632;
            color: #fff;
            border-radius: 50%;
            transition: all 0.3s;
            display: none;
        }

        #back-top a {
            color: #fff;
        }

        #back-top:hover {
            background: #333;
            transform: translateY(-3px);
        }

        .footer-tittle ul li a {
            color: #fff;
            transition: color 0.3s;
        }

        .footer-tittle ul li a:hover {
            color: #fdc632;
            text-decoration: none;
        }

        @media (max-width: 991px) {
            .main-menu #navigation li a {
                font-size: 16px;
                margin-right: 15px;
            }
        }

        @media (max-width: 767px) {
            .main-menu #navigation li a {
                font-size: 15px;
                margin-right: 10px;
            }

            .header-right-btn {
                margin-left: 15px !important;
            }

            .hero__caption h1 {
                font-size: 2rem;
            }
        }

        .services-area {
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }
    </style>
