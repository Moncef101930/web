{% extends 'basefront.html.twig' %}

{% block title %}Mes tickets{% endblock %}

{% block main %}
<div class="container py-5">
  <h2>Mes Tickets</h2>

  {% if tickets|length > 0 %}
    <table class="table table-striped">
      <thead>
        <tr>
          <th>ID</th>
          <th>Événement</th>
          <th>Date d’achat</th>
          <th>Type</th>
        </tr>
      </thead>
      <tbody>
        {% for ticket in tickets %}
          <tr>
            <td>{{ ticket.id }}</td>
            <td>{{ ticket.evenementNom }}</td>
            <td>{{ ticket.dateAchat|date('d/m/Y') }}</td>
            <td>{{ ticket.typeTicket }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="mt-4">Vous n’avez pas encore de tickets.</p>
  {% endif %}
</div>
{% endblock %}
